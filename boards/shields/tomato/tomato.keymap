#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define SOLIDWORKS 1

/ {
    macros {
        ctrl_mmb_hold: ctrl_mmb_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL>
                , <&macro_press &mkp MB3>
                , <&macro_pause_for_release>     // This makes it hold
                , <&macro_release &mkp MB3>
                , <&macro_release &kp LCTRL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <       
&kp GRAVE	&kp ESCAPE	&kp N1	&kp N2	&kp N3	&kp N4	&kp N5	&kp N6	&bt BT_SEL 1			&to 1	&kp Y	&kp N7	&kp N8	&kp N9	&kp N0	&kp MINUS	&kp EQUAL	&kp DELETE
&mkp RCLK	&kp TAB	&kp Q	&kp W	&kp E	&kp R	&kp T	&kp BSPC	&bt BT_CLR	&bt BT_SEL 2	&kp N6	&kp N1	&kp Y	&kp U	&kp I	&kp O	&kp P	&kp LBKT	&kp RBKT	&kp BSLH
&mkp MCLK	&kp SPACE	&kp A	&kp S	&kp D	&kp F	&kp G	&kp ENTER	&kp UP	&kp C_PLAY_PAUSE	&kp C_PLAY_PAUSE	&kp BSPC	&kp H	&kp J	&kp K	&kp L	&kp SEMI	&kp APOS	&kp ENTER	&kp LC(LA(LS(F1)))
&kp CAPS	&kp LSHIFT	&kp Z	&kp X	&kp C	&kp V	&kp B	&kp LEFT	&kp DOWN	&kp RIGHT	&kp ENTER	&kp SPACE	&kp N	&kp M	&kp COMMA	&kp PERIOD	&kp SLASH	&kp LSHIFT	&kp UP	&kp LC(F2)
&kp DELETE	&kp LCTRL	&kp LEFT_WIN	&kp LALT	&kp SPACE	&kp SPACE	&kp LC(LA(LS(F1)))	&msc SCRL_DOWN	&msc SCRL_UP	 &kp LA(TAB)	&kp N9 	&kp DELETE	&kp SPACE	&kp SPACE	&kp F2	&kp F4	&kp F11	&kp LEFT	&kp DOWN	&kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

         SOLIDWORKS {
            bindings = <       
&kp GRAVE	&kp ESCAPE	&kp N1	&kp N2	&kp N3	&kp N4	&kp N5	&kp N6	&bt BT_SEL 1			&to 0	&kp Y	&kp N7	&kp N8	&kp N9	&kp N0	&kp MINUS	&kp EQUAL	&kp DELETE
&mkp MCLK	&kp TAB	&kp Q	&kp W	&kp E	&kp R	&kp T	&kp BSPC	&bt BT_CLR	&bt BT_SEL 2	&kp N6	&kp N1	&kp Y	&kp U	&kp I	&kp O	&kp P	&kp LBKT	&kp RBKT	&kp BSLH
&ctrl_mmb_hold	&kp SPACE	&kp A	&kp S	&kp D	&kp F	&kp G	&kp ENTER	&kp UP	&kp C_PLAY_PAUSE	&kp C_PLAY_PAUSE	&kp BSPC	&kp H	&kp J	&kp K	&kp L	&kp SEMI	&kp APOS	&kp ENTER	&kp LC(LA(LS(F1)))
&kp CAPS	&kp LSHIFT	&kp Z	&kp X	&kp C	&kp V	&kp B	&kp LEFT	&kp DOWN	&kp RIGHT	&kp ENTER	&kp SPACE	&kp N	&kp M	&kp COMMA	&kp PERIOD	&kp SLASH	&kp LSHIFT	&kp UP	&kp LC(F2)
&kp DELETE	&kp LCTRL	&kp LEFT_WIN	&kp LALT	&kp SPACE	&kp SPACE	&kp LC(LA(LS(F1)))	&msc SCRL_DOWN	&msc SCRL_UP	 &kp LA(TAB)	&kp N9 	&kp DELETE	&kp SPACE	&kp SPACE	&kp F2	&kp F4	&kp F11	&kp LEFT	&kp DOWN	&kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
