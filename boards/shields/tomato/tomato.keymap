#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define NUMPAD 1
#define FUSION 2

/ {
    macros {
        ctrl_mmb_hold: ctrl_mmb_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL>
                , <&macro_press &mkp MB3>
                , <&macro_pause_for_release>     // This makes it hold (For solidworks mostly)
                , <&macro_release &mkp MB3>
                , <&macro_release &kp LCTRL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <       
&kp GRAVE	&kp ESCAPE	&kp N1	&kp N2	&kp N3	&kp N4	&kp N5	&kp N6	&bt BT_SEL 1			&kp 0	&kp N6	&kp N7	&kp N8	&kp N9	&kp N0	&kp MINUS	&kp EQUAL	&kp DELETE
&mkp RCLK	&kp TAB	&kp Q	&kp W	&kp E	&kp R	&kp T	&kp BSPC	&bt BT_SEL 2	&bt BT_CLR	&to FUSION	&kp LC(LA(LS(F13)))	&kp Y	&kp U	&kp I	&kp O	&kp P	&kp LBKT	&kp RBKT	&kp BSLH
&mkp MCLK	&kp SPACE	&kp A	&kp S	&kp D	&kp F	&kp G	&kp ENTER	&kp UP	&kp C_PLAY_PAUSE	&kp 0	&kp BSPC	&kp H	&kp J	&kp K	&kp L	&kp SEMI	&kp APOS	&kp ENTER	&kp LC(LA(LS(F1)))
&kp CAPS	&kp LSHIFT	&kp Z	&kp X	&kp C	&kp V	&kp B	&kp LEFT	&kp DOWN	&kp RIGHT	&kp ENTER	&kp SPACE	&kp N	&kp M	&kp COMMA	&kp PERIOD	&kp SLASH	&kp LSHIFT	&kp F11	&kp LC(F2)
&kp DELETE	&kp LCTRL	&kp LEFT_WIN	&kp LALT	&kp SPACE	&kp SPACE	&kp LC(LA(LS(F1)))	 &kp LA(TAB)	&kp LC(F2)	&to NUMPAD	&kp N9 	&kp F1	&kp F2	&kp F3	&kp F4	&kp F5	&kp F6	&kp F7	&kp F8	&kp LC(LA(LS(F13)))
           >; 
            
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

         NUMPAD {
            bindings = <       
&kp GRAVE	&kp ESCAPE	&kp MINUS	&kp PLUS	&kp PERIOD	&kp N0	&kp N0	&to 0	&bt BT_SEL 1			&kp 0	&kp N6	&kp N7	&kp N8	&kp N9	&kp N0	&kp MINUS	&kp EQUAL	&kp DELETE
&mkp RCLK	&kp TAB	&kp N7	&kp N8	&kp N9	&kp BSPC	&kp N0	&to 1	&bt BT_SEL 2	&bt BT_CLR	&to DEFAULT	&kp LC(LA(LS(F13)))	&kp Y	&kp U	&kp I	&kp O	&kp P	&kp LBKT	&kp RBKT	&kp BSLH
&mkp MCLK	&kp ENTER	&kp N4	&kp N5	&kp N6	&kp ENTER	&kp UP	&to 2	&kp N0	&kp C_PLAY_PAUSE	&kp 0	&kp BSPC	&kp H	&kp J	&kp K	&kp L	&kp SEMI	&kp APOS	&kp ENTER	&kp LC(LA(LS(F1)))
&to FUSION	&kp N0	&kp N1	&kp N2	&kp N3	&kp LEFT	&kp DOWN	&kp N0	&kp N0	&kp N0	&kp ENTER	&kp SPACE	&kp N	&kp M	&kp COMMA	&kp PERIOD	&kp SLASH	&kp LSHIFT	&kp F11	&kp LC(F2)
&kp DELETE	&kp LCTRL	&kp LEFT_WIN	&kp LALT	&kp SPACE	&kp SPACE	&kp LC(LA(LS(F1)))	 &kp LA(TAB)	&kp LC(F2)	&to DEFAULT	&kp N9 	&kp F1	&kp F2	&kp F3	&kp F4	&kp F5	&kp F6	&kp F7	&kp F8	&kp LC(LA(LS(F13)))
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

         FUSION {
            bindings = <       
&kp H	&kp ESCAPE	&kp L	&kp M	&kp  I	&kp P	&kp O	&kp N6	&bt BT_SEL 1			&kp 0	&kp N6	&kp N7	&kp N8	&kp N9	&kp N0	&kp MINUS	&kp EQUAL	&kp DELETE
&mkp RCLK	&kp TAB	&kp Q	&kp W	&kp E	&kp R	&kp T	&kp BSPC	&bt BT_SEL 2	&bt BT_CLR	&to DEFAULT	&kp LC(LA(LS(F13)))	&kp Y	&kp U	&kp I	&kp O	&kp P	&kp LBKT	&kp RBKT	&kp BSLH
&mkp MCLK	&kp SPACE	&kp A	&kp S	&kp D	&kp F	&kp G	&kp ENTER	&kp UP	&kp C_PLAY_PAUSE	&kp 0	&kp BSPC	&kp H	&kp J	&kp K	&kp L	&kp SEMI	&kp APOS	&kp ENTER	&kp LC(LA(LS(F1)))
&to NUMPAD	&kp LSHIFT	&kp Z	&kp X	&kp C	&kp V	&kp B	&kp LEFT	&kp DOWN	&kp RIGHT	&kp ENTER	&kp SPACE	&kp N	&kp M	&kp COMMA	&kp PERIOD	&kp SLASH	&kp LSHIFT	&kp F11	&kp LC(F2)
&kp DELETE	&kp LCTRL	&kp LEFT_WIN	&kp LALT	&kp SPACE	&kp SPACE	&kp LC(LA(LS(F1)))	 &kp LA(TAB)	&kp LC(F2)	&to DEFAULT	&kp N9 	&kp F1	&kp F2	&kp F3	&kp F4	&kp F5	&kp F6	&kp F7	&kp F8	&kp LC(LA(LS(F13)))
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
